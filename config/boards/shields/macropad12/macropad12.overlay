#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        
        input-gpios
            = <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Replaces 100 */
            , <&pro_micro_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Replaces 104 */
            , <&pro_micro_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Replaces 106 */
            , <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro_a 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* Replaces 111 */
            ;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "12-Key Direct";
        kscan = <&kscan0>;
        
        transform = <&layout_transform0>;
    };

    layout_transform0: layout_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)  RC(0,3)
            RC(0,4) RC(0,5) RC(0,6)  RC(0,7)
            RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        >;
    };
};
