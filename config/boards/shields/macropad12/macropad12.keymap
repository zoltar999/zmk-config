#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: F-Keys & Bootloader
        default_layer {
            bindings = <
                &kp F13      &kp F16      &kp F17      &kp F18
                &kp F19      &kp F20      &kp F21      &kp F22
                &kp F23      &kp F24      &bootloader  &mo 1
            >;
        };

        // Layer 1: Media & System Controls
        layer_1 {
            bindings = <
                &kp C_PP     &kp C_NEXT   &kp C_PREV   &kp C_AL_CALC
                &kp C_VOL_UP &kp C_VOL_DN &kp C_BRI_UP &kp C_BRI_DN
                &kp C_MUTE   &kp K_MUTE   &kp C_AL_LOCK &trans
            >;
        };
    };
};
